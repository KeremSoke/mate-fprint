#: data/org.mate.fprint.desktop.in:2 data/org.mate.fprint.metainfo.xml.in:4
#: src/main.vala:267 src/main.vala:422 src/main.vala:783
msgid "Fingerprint Login"
msgstr "Parmak İziyle Oturum Açma"

#: data/org.mate.fprint.desktop.in:3
msgid "Register fingerprints for authentication"
msgstr "Kimlik doğrulama için parmak izlerini kaydet"

#: data/org.mate.fprint.desktop.in:9
msgid "fingerprint;login;authentication;security;"
msgstr "parmak izi;oturum açma;kimlik doğrulama;güvenlik;"

#: data/org.mate.fprint.metainfo.xml.in:5
msgid "Manage fingerprint authentication in MATE"
msgstr "MATE'de parmak iziyle kimlik doğrulamayı yönetin"

#: data/org.mate.fprint.metainfo.xml.in:9
msgid "MATE Fingerprint contributors"
msgstr "MATE Fingerprint katkıcıları"

#: data/org.mate.fprint.metainfo.xml.in:13
msgid "Register and remove fingerprints for the MATE desktop."
msgstr "MATE masaüstü için parmak izlerini kaydedin veya kaldırın."

#: src/main.vala:55 src/main.vala:424
msgid "Fingerprint reader"
msgstr "Parmak izi okuyucu"

#: src/main.vala:254
msgid "Left thumb"
msgstr "Sol başparmak"

#: src/main.vala:255
msgid "Left index"
msgstr "Sol işaret parmağı"

#: src/main.vala:256
msgid "Left middle"
msgstr "Sol orta parmak"

#: src/main.vala:257
msgid "Left ring"
msgstr "Sol yüzük parmağı"

#: src/main.vala:258
msgid "Left little"
msgstr "Sol serçe parmak"

#: src/main.vala:259
msgid "Right thumb"
msgstr "Sağ başparmak"

#: src/main.vala:260
msgid "Right index"
msgstr "Sağ işaret parmağı"

#: src/main.vala:261
msgid "Right middle"
msgstr "Sağ orta parmak"

#: src/main.vala:262
msgid "Right ring"
msgstr "Sağ yüzük parmağı"

#: src/main.vala:263
msgid "Right little"
msgstr "Sağ serçe parmak"

#: src/main.vala:327
msgid "_Fingerprint"
msgstr "_Parmak İzi"

#: src/main.vala:329
msgid "_Refresh"
msgstr "_Yenile"

#: src/main.vala:331
msgid "_Disable Fingerprint Authentication"
msgstr "Parmak İziyle Kimlik Doğrulamayı _Devre Dışı Bırak"

#: src/main.vala:333
msgid "_Quit"
msgstr "_Çık"

#: src/main.vala:342
msgid "_Help"
msgstr "_Yardım"

#: src/main.vala:344
msgid "_About"
msgstr "_Hakkında"

#: src/main.vala:374
msgid "Looking for a fingerprint reader…"
msgstr "Parmak izi okuyucu aranıyor…"

#: src/main.vala:382
msgid "No fingerprint reader detected"
msgstr "Parmak izi okuyucu algılanmadı"

#: src/main.vala:383
msgid ""
"Connect a supported reader, then try again.\n"
"The fprintd service must also be installed and running."
msgstr ""
"Desteklenen bir okuyucu bağlayıp yeniden deneyin.\n"
"fprintd hizmeti de kurulu ve çalışıyor olmalıdır."

#: src/main.vala:386
msgid "_Try Again"
msgstr "_Yeniden Dene"

#: src/main.vala:399
msgid "Fingerprint authentication is disabled"
msgstr "Parmak iziyle kimlik doğrulama devre dışı"

#: src/main.vala:400
msgid ""
"Enable fingerprint authentication for login, screen unlocking,\n"
"and administrative actions."
msgstr ""
"Oturum açma, ekran kilidi açma ve yönetim işlemleri için\n"
"parmak iziyle kimlik doğrulamayı etkinleştirin."

#: src/main.vala:403
msgid "_Enable Fingerprint Authentication"
msgstr "Parmak İziyle Kimlik Doğrulamayı _Etkinleştir"

#: src/main.vala:432
msgid "Registered fingerprints"
msgstr "Kayıtlı parmak izleri"

#: src/main.vala:440
msgid "Select a finger to register, replace, or remove it."
msgstr "Kaydetmek, değiştirmek veya kaldırmak için bir parmak seçin."

#: src/main.vala:454
msgid "Registered"
msgstr "Kayıtlı"

#: src/main.vala:454
msgid "Not registered"
msgstr "Kayıtlı değil"

#: src/main.vala:483 src/main.vala:752
msgid "_Remove"
msgstr "_Kaldır"

#: src/main.vala:486 src/main.vala:614
msgid "_Register"
msgstr "_Kaydet"

#: src/main.vala:502 src/main.vala:624
msgid "Place your finger on the reader"
msgstr "Parmağınızı okuyucunun üzerine yerleştirin"

#: src/main.vala:504 src/main.vala:625
msgid "Lift and place the same finger again after each scan."
msgstr "Her taramadan sonra aynı parmağı kaldırıp yeniden yerleştirin."

#: src/main.vala:514 src/main.vala:629
msgid "_Cancel"
msgstr "_İptal"

#: src/main.vala:541 src/main.vala:545 src/main.vala:549
msgid "Could not change fingerprint authentication"
msgstr "Parmak iziyle kimlik doğrulama değiştirilemedi"

#: src/main.vala:541
msgid "The system configuration command failed."
msgstr "Sistem yapılandırma komutu başarısız oldu."

#: src/main.vala:561
msgid "Demo fingerprint reader"
msgstr "Demo parmak izi okuyucu"

#: src/main.vala:611
msgid "This fingerprint is registered."
msgstr "Bu parmak izi kayıtlı."

#: src/main.vala:611
msgid "This fingerprint is not registered."
msgstr "Bu parmak izi kayıtlı değil."

#. Translators: %s is a finger name in lowercase, such as "left index".
#: src/main.vala:623
#, c-format
msgid "Register %s"
msgstr "%s kaydet"

#: src/main.vala:639
msgid "Could not start enrollment"
msgstr "Kayıt başlatılamadı"

#. Translators: the first %d is the number of completed scans, the second the total.
#: src/main.vala:662
#, c-format
msgid "%d of %d scan"
msgid_plural "%d of %d scans"
msgstr[0] "%d/%d tarama"

#: src/main.vala:665
msgid "Good scan! Keep going."
msgstr "İyi tarama! Devam edin."

#: src/main.vala:666
msgid "Lift your finger, then place it on the reader again."
msgstr "Parmağınızı kaldırıp okuyucunun üzerine yeniden yerleştirin."

#: src/main.vala:672
msgid "Complete"
msgstr "Tamamlandı"

#: src/main.vala:675
msgid "Fingerprint registered"
msgstr "Parmak izi kaydedildi"

#: src/main.vala:676
msgid "You can now use this finger to authenticate."
msgstr "Artık kimlik doğrulamak için bu parmağı kullanabilirsiniz."

#: src/main.vala:677
msgid "_Done"
msgstr "_Bitti"

#: src/main.vala:684 src/main.vala:688
msgid "Try that scan again"
msgstr "Bu taramayı yeniden deneyin"

#: src/main.vala:685
msgid "Remove your finger completely, then place it on the reader."
msgstr "Parmağınızı tamamen kaldırıp okuyucunun üzerine yerleştirin."

#: src/main.vala:689
msgid "Move your finger slightly and try again."
msgstr "Parmağınızı biraz oynatıp yeniden deneyin."

#: src/main.vala:692
msgid "The swipe was too short"
msgstr "Kaydırma çok kısaydı"

#: src/main.vala:693
msgid "Swipe the full length of your finger over the reader."
msgstr "Parmağınızın tamamını okuyucunun üzerinde kaydırın."

#: src/main.vala:696
msgid "Center your finger"
msgstr "Parmağınızı ortalayın"

#: src/main.vala:697
msgid "Place the middle of your fingertip on the reader."
msgstr "Parmak ucunuzun ortasını okuyucunun üzerine yerleştirin."

#: src/main.vala:700
msgid "Fingerprint already registered"
msgstr "Parmak izi zaten kayıtlı"

#: src/main.vala:701
msgid "Choose a different finger or remove the existing fingerprint first."
msgstr "Farklı bir parmak seçin veya önce var olan parmak izini kaldırın."

#: src/main.vala:704
msgid "Fingerprint storage is full"
msgstr "Parmak izi depolama alanı dolu"

#: src/main.vala:705
msgid "Remove a fingerprint before registering another one."
msgstr "Başka bir parmak izi kaydetmeden önce bir parmak izini kaldırın."

#: src/main.vala:708
msgid "Reader disconnected"
msgstr "Okuyucunun bağlantısı kesildi"

#: src/main.vala:709
msgid "Reconnect the fingerprint reader and try again."
msgstr "Parmak izi okuyucuyu yeniden bağlayıp tekrar deneyin."

#: src/main.vala:712
msgid "Fingerprint was not registered"
msgstr "Parmak izi kaydedilmedi"

#: src/main.vala:713
msgid "Please cancel and try again."
msgstr "Lütfen iptal edip yeniden deneyin."

#: src/main.vala:717
msgid "_Back"
msgstr "_Geri"

#. Translators: %s is a finger name in lowercase, such as "left index".
#: src/main.vala:748
#, c-format
msgid "Remove %s?"
msgstr "%s kaldırılsın mı?"

#: src/main.vala:751
msgid "You will no longer be able to authenticate with this fingerprint."
msgstr "Bu parmak iziyle artık kimlik doğrulayamayacaksınız."

#: src/main.vala:766
msgid "Could not remove fingerprint"
msgstr "Parmak izi kaldırılamadı"

#: src/main.vala:785
msgid "Manage fingerprint authentication for the MATE desktop"
msgstr "MATE masaüstü için parmak iziyle kimlik doğrulamayı yönetin"
