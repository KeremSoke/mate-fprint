<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.mate.fprint</id>
  <name>Fingerprint Login</name>
  <summary>Manage fingerprint authentication in MATE</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="org.mate.fprint">
    <name>MATE Fingerprint contributors</name>
  </developer>
  <url type="homepage">https://mate-desktop.org/</url>
  <description>
    <p>Register and remove fingerprints for the MATE desktop.</p>
  </description>
  <launchable type="desktop-id">org.mate.fprint.desktop</launchable>
  <provides>
    <binary>mate-fprint</binary>
  </provides>
  <content_rating type="oars-1.1"/>
</component>
